// Cloudflare deploy settings, read by `npx wrangler deploy`.
//
// The shop is a static site: `npm run build` writes it to out/ and Cloudflare
// serves those files as they are. Without this file wrangler guesses that a
// Next.js project needs a server and sets up the OpenNext adapter, which a
// static export cannot use.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jouluecom",
  "compatibility_date": "2026-11-10",
  // The small server side: checkout, order status, Stripe webhook.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Unknown addresses get out/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Only /api/* reaches the Worker; pages are served straight from files.
    "run_worker_first": ["/api/*"]
  }
}
